# Example environment variables for Time-logger-for-different-tasks
# Copy this file to `.env.local` (which should NOT be committed) and replace placeholders with real values.
# For deployments (Vercel), set the same variables in Project Settings → Environment Variables instead of committing them.

# MongoDB connection string (used by src/lib/mongodb.ts via Mongoose)
MONGODB_URI="mongodb://<user>:<password>@<host>:<port>/<database>"

# Auth.js / NextAuth secret used to sign session tokens.
# Generate one with: openssl rand -base64 33
AUTH_SECRET="replace_with_a_secure_random_value"

# Google OAuth provider (src/lib/auth.ts, src/lib/auth.config.ts)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

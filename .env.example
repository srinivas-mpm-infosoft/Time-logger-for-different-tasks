# Example environment variables for Time-logger-for-different-tasks
# Copy this file to `.env.local` (which should NOT be committed) and replace placeholders with real values.
# For deployments (Vercel), set the same variables in Project Settings → Environment Variables instead of committing them.

# Primary database connection URL (MySQL)
# Replace with a real connection string like:
# mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="mysql://root:your_password@your_host:47366/test"

# Alternate variable name some setups use (optional)
# MYSQL_URL="mysql://root:your_password@your_host:47366/test"

# Example: if you want to use the connection string you provided locally, copy it into .env.local:
# DATABASE_URL="mysql://root:KyfbQYIzmmLUClWQQsJkyHpCfJPuMENK@hayabusa.proxy.rlwy.net:47366/test"

# Other common env vars (examples)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=replace_with_a_secure_random_value
